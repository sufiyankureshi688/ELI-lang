# ============================================================
# ELI Feature Test Suite: typedef, pipeline, memoize
# ============================================================

# --- SECTION 1: typedef + tassign ---

typedef pos width
typedef pos height
typedef neg temperature
typedef int score

tassign width = 10
tassign height = 4
tassign temperature = -7
tassign score = -50

print @ width
print @ height
print @ temperature
print @ score

# --- SECTION 2: pipeline ---

# pipe single value into print
@ width |> print

# pipe expression into print
area = @ width @ height M
@ area |> print

# pipe negative into print
@ temperature |> print

# --- SECTION 3: memoize ---

# cache miss: compute width squared
memoize w_sq = @ width @ width M using _w_cache
print @ w_sq

# cache hit: same result, no recompute
memoize w_sq = @ width @ width M using _w_cache
print @ w_sq

# independent cache for height squared
memoize h_sq = @ height @ height M using _h_cache
print @ h_sq

memoize h_sq = @ height @ height M using _h_cache
print @ h_sq

# --- SECTION 4: all three together ---
# typed variable, piped into print, result memoized

typedef pos side
tassign side = 9

memoize side_sq = @ side @ side M using _side_cache

@ side_sq |> print

memoize side_sq = @ side @ side M using _side_cache

@ side_sq |> print

halt
