# ============================================================
# ELI SAFETY FEATURES — ALL THREE AS .kw FILES
# Zero compiler changes. Pure .kw library.
# ============================================================

# ---- FEATURE 1: PATTERN MATCHING ----
# Three-case match with else
x = 2
match @ x :
    case 1 : print 100 endcase
    case 2 : print 200 endcase
    case 3 : print 300 endcase
    else : print 999
endmatch

# One-case match (no else)
y = 7
match @ y :
    case 7 : print 700 endcase
endmatch

# No match hit (else branch)
z = 99
match @ z :
    case 1 : print 111 endcase
    case 2 : print 222 endcase
    else : print 0
endmatch

# ---- FEATURE 2: BORROW CHECKER ----
# own, move, buse
own a
a = 42
own b
b = 0
print @ a
move a to b
print @ b

# buse on valid (unfreed) variable is fine
own c
c = 55
buse c = @ c 10 A
print @ c

# ---- FEATURE 3: STATIC TYPE INFERENCE ----
typedef pos p1
typedef pos p2
typedef neg n1
typedef neg n2

tassign p1 = 6
tassign p2 = 7
tassign n1 = -5
tassign n2 = -3

# pos * pos -> inferred pos
tinfer prod = @ p1 @ p2 M typed p1 times p2
print @ prod

# neg + neg -> inferred neg
tinfer negsum = @ n1 @ n2 A typed n1 plus n2
print @ negsum

# pos + neg -> inferred int (no guard)
tinfer mixed = @ p1 @ n1 A typed p1 plus n1
print @ mixed

halt
