# ================================================
# ELI All Keywords - Comprehensive Test Suite
# Run: python3 src/alpha_p3.py --run src/test.eli2
# ================================================

# --- abs ---
x = 0 9 s
abs x
print @ _abs    # expect 9
x = 9
abs x
print @ _abs    # expect 9

# --- sign ---
x = 0 5 s
sign x
print @ _sign   # expect -1
x = 0
sign x
print @ _sign   # expect 0
x = 7
sign x
print @ _sign   # expect 1

# --- clamp ---
lo = 0
hi = 10
v = 99
clamp v lo hi
print @ _clamp  # expect 10
v = 0 5 s
clamp v lo hi
print @ _clamp  # expect 0
v = 5
clamp v lo hi
print @ _clamp  # expect 5

# --- swap ---
a = 1
b = 2
swap a b
print @ a       # expect 2
print @ b       # expect 1

# --- min ---
a = 3
b = 7
min a b
print @ _min    # expect 3

# --- max ---
a = 3
b = 7
max a b
print @ _max    # expect 7

a = 10
b = 2
max a b
print @ _max    # expect 10

# --- assert pass ---
x = 5
assert @ x 0 G
print @ x       # expect 5

# --- printchar ---
printchar 72    # H
printchar 105   # i
printchar 10    # newline

# --- println ---
println 42      # expect 42
println 99      # expect 99

# --- func + call ---
func square :
    U M Q
endfunc

func add :
    A Q
endfunc

5 call square P     # expect 25
3 4 call add P      # expect 7

# --- return ---
func double :
    return U A
endfunc

6 call double P     # expect 12

# --- recursive func ---
func factorial :
    if U 2 L :
        V return 1
    endif
    U 1 s call factorial M Q
endfunc

5 call factorial P  # expect 120

# --- while loop ---
c = 0
while @ c 5 L :
    c++
endwhile
print @ c           # expect 5

# sum 1..5
s = 0
i = 1
while @ i 6 L :
    s += @ i
    i++
endwhile
print @ s           # expect 15

# --- for loop (natural syntax sugar) ---
total = 0
for k from 1 to 4 :
    total += @ k
endfor
print @ total       # expect 6  (1+2+3)

# --- match ---
val = 2
match @ val :
    case 1 :
        println 111
    endcase
    case 2 :
        println 222
    endcase
    case 3 :
        println 333
    endcase
endmatch
# expect 222

val = 99
match @ val :
    case 1 :
        println 444
    endcase
    else :
        println 555
endmatch
# expect 555

# --- pipeline |> ---
r = 3 4 A
print @ r           # expect 7

# pipeline: 10 |> push, then dup + multiply = square
r = 10 |> U M
print @ r           # expect 100

# --- newarray + lenarray ---
newarray scores 5
lenarray scores
print @ _len        # expect 5

# --- setarray + getarray ---
i = 0
setarray scores i 10
i++
setarray scores i 20
i++
setarray scores i 30

i = 0
getarray scores i
print @ _get        # expect 10
i++
getarray scores i
print @ _get        # expect 20
i++
getarray scores i
print @ _get        # expect 30

# --- two independent arrays ---
newarray arr1 3
newarray arr2 3
i = 0
setarray arr1 i 100
setarray arr2 i 200
getarray arr1 i
print @ _get        # expect 100
getarray arr2 i
print @ _get        # expect 200

# --- typedef + tassign + typecheck ---
typedef pos px
tassign px = 5
print @ px          # expect 5

typedef neg nx
tassign nx = 0 3 s
print @ nx          # expect -3

# --- own + buse ---
own myvar
buse myvar = 42
print @ myvar       # expect 42

# --- move ---
own src
buse src = 77
move src to dst
print @ dst         # expect 77

# --- memoize ---
cache = 0
memoize result = 999 using cache
print @ result      # expect 999 (first time, computed)
memoize result = 0 using cache
print @ result      # expect 999 (second time, cached)

halt
