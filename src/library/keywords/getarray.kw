KEYWORD getarray

# getarray ?arr ?idx
#
# Loads arr[idx] into _get. Data starts at base+1, so the actual
# memory address is @ ?arr + ?idx + 1.
#
# EXAMPLE
#   newarray scores 5
#   i = 0
#   setarray scores i 42
#   getarray scores i
#   print @ _get        # 42

SYNTAX
getarray ?arr ?idx

COMPILATION
_get = @ ?arr @ ?idx 1 A A F
