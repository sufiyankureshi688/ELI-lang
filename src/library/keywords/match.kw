KEYWORD match

# Base: single case, no else
SYNTAX
match *expr : case *val : **body endcase endmatch

COMPILATION
if *expr *val E :
**body
endif

# Base: single case with else
SYNTAX
match *expr : case *val : **body endcase else : **elsebody endmatch

COMPILATION
if *expr *val E :
**body
else :
**elsebody
endif

# Recursive: multiple cases (no else) — peel first case, re-emit rest as match
SYNTAX
match *expr : case *val : **body endcase **rest endmatch

COMPILATION
if *expr *val E :
**body
else :
match *expr : **rest endmatch
endif

# Recursive: multiple cases with else — peel first case, re-emit rest as match
# (This works because **rest will include remaining cases + else)
