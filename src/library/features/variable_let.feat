# LET ?name = *expr
# Emits: <expr...> <addr> T
#
# ELI computes the variable address.
# ct_state[10000 + hash(name)] = address
# ct_state[9999] = next free address counter

MATCH LET ?name = *expr \n

CONSTRAINT
single(name)
is_name(name)
non_empty(expr)

ELI
# key = 10000 + hash(name)
-50 q 10000 ADD
# save key in mem[0], load current addr
U 0 STORE
q
# if addr == 0: allocate
U 0 EQUAL NOT 21 JUMP_NOT_ZERO
DROP
# get next_free, default to 1 if 0
9999 q U 0 EQUAL NOT 3 JUMP_NOT_ZERO 1 ADD
# addr is now on stack. save it.
U 1 ADD 9999 w
U 0 LOAD w
# reload addr
0 LOAD q

EMIT
{expr} {0} T
